# Telegram Bot
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz_SAMPLE
BOT_USERNAME=NoShowGuardBot
MINI_APP_SHORT_NAME=app

# WebApp URL (Telegram Mini App)
# Для локальной разработки: http://localhost:8000/app
# Для боевой работы в Telegram TMA нужен валидный HTTPS-домен:
WEBAPP_URL=https://your-domain.com/app
MINI_APP_URL=https://t.me/NoShowGuardBot/app

# Database (Default: local SQLite with WAL mode)
# For PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/noshowguard
DATABASE_URL=sqlite+aiosqlite:///./noshowguard.db

# YooKassa SBP Payments
# If empty or set to test, payment service operates in sandbox/mock mode for testing
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_SANDBOX=True

# Application & Webhook Settings
HOST=0.0.0.0
PORT=8000
WEBHOOK_BASE_URL=http://localhost:8000
DEFAULT_DEPOSIT_AMOUNT=300
DEPOSIT_LOCK_MINUTES=10
